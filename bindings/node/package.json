{
  "name": "@madeitpx/pixelart",
  "version": "0.2.1",
  "description": "Node.js binding for the madeitpx pixel-art image conversion library",
  "license": "MPL-2.0",
  "author": "TamKungZ_ <dev@tamkungz.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TamKungZ/madeitpx.git",
    "directory": "bindings/node"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./browser.d.ts",
        "default": "./browser.mjs"
      },
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./browser": {
      "types": "./browser.d.ts",
      "default": "./browser.mjs"
    },
    "./madeitpx.wasm": "./wasm/madeitpx.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "browser.mjs",
    "browser.d.ts",
    "wasm/madeitpx.wasm",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "koffi": "^3.3.3"
  },
  "optionalDependencies": {
    "@madeitpx/pixelart-darwin-arm64": "0.2.1",
    "@madeitpx/pixelart-darwin-x64": "0.2.1",
    "@madeitpx/pixelart-linux-arm64-gnu": "0.2.1",
    "@madeitpx/pixelart-linux-x64-gnu": "0.2.1",
    "@madeitpx/pixelart-win32-arm64": "0.2.1",
    "@madeitpx/pixelart-win32-x64": "0.2.1"
  },
  "allowScripts": {
    "koffi@3.3.3": true
  },
  "browser": "./browser.mjs",
  "sideEffects": false
}
